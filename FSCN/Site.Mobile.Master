                </style>


                <script>
                    $(function () {
                        var path = window.location.pathname;
                        $('.navbar.fixed-bottom .nav-link').each(function () {
                            if (this.getAttribute('href') === path) {
                                $(this).addClass('active');
                            }
                        });
                    });

                </script>
