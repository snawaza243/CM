                <style>
                    @media (max-width: 991.98px) {
                        /* Force nav horizontal */
                        .mobile-bottom-nav .navbar-nav {
                            flex-direction: row !important;
                        }

                            .navbar-nav .nav-item {
                                flex: 1;
                                text-align: center;
                            }

                        /* Keep height compact */
                        nav.mobile-bottom-nav {
                            height: 65px;
                            overflow: hidden;
                            /* Force bottom attach */
                            position: fixed !important;
                            bottom: 0 !important;
                            top: auto !important;
                            left: 0;
                            right: 0;
                        }

