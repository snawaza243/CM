            <!-- Bootstrap JS with Popper -->



            <script>

                function initNavbarToggle(togglerSelector, navSelector) {
                    const toggler = $(togglerSelector);
                    const nav = $(navSelector);
                    const icon = toggler.find('i');

                    // Hide nav initially (in case show class is present)
                    nav.hide();

                    toggler.on('click', function () {
                        nav.stop(true, true).slideToggle(300, function () {
                            // Toggle icon after animation completes
                            if (nav.is(':visible')) {
                                icon.removeClass('fa-bars').addClass('fa-xmark');
                                toggler.attr('aria-expanded', 'true');
                            } else {
                                icon.removeClass('fa-xmark').addClass('fa-bars');
                                toggler.attr('aria-expanded', 'false');
                            }
                        });
                    });

                    // Auto close menu when clicking a nav link (mobile)
                    $(navSelector + ' .nav-link').on('click', function () {
                        if (nav.is(':visible')) {
                            nav.stop(true, true).slideUp(300, function () {
                                icon.removeClass('fa-xmark').addClass('fa-bars');
                                toggler.attr('aria-expanded', 'false');
                            });
                        }
                    });
                }


                function preventDefaultActions(preventClick = false, preventEnter = false) {
                    if (preventClick) {
                        // Prevent default click behavior on all buttons
                        $(document).on('click.preventBtn', 'button, input[type="submit"]', function (e) {
                            e.preventDefault();
                            console.log('Button click prevented');
                        });
                    } else {
                        // Remove click prevention if it was previously bound
                        $(document).off('click.preventBtn');
                    }

                    if (preventEnter) {
                        // Prevent Enter key from submitting the first button
                        $(document).on('keydown.preventEnter', function (e) {
                            if (e.key === "Enter" || e.keyCode === 13) {
                                e.preventDefault();
                                console.log('Enter key prevented');
                                return false;
                            }
                        });
                    } else {
                        // Remove Enter key prevention
                        $(document).off('keydown.preventEnter');
                    }
                }

                function activeCurrentPageNav() {
                    // Get current page URL
                    var currentUrl = window.location.pathname;

                    // Remove active class from all nav links
                    $('.navbar-nav .nav-link').removeClass('active');

                    // Add active class to current page link
                    $('.navbar-nav .nav-link').each(function () {
                        var linkUrl = $(this).attr('href');

                        // Check if the link URL matches the current page URL
                        if (currentUrl === linkUrl) {
                            console.log('hii');
                            $(this).addClass('active');
                        }

                        // Handle home page specifically (often just '/' or '/index.html')
                        if (currentUrl === '/' || currentUrl === '/index.html') {
                            if (linkUrl === '/' || linkUrl === '/index.html') {
                                $(this).addClass('active');
                            }
                        }
                    });

                    var toolsPages = [
                        "/Floor_Planner",
                        "/Material_Calculator",
                        "/Roof_Calculator",
                        "/Unit_Convertor",
                        "/Cost_Estimator",
                        "/Project_Timeline_Planner",
                        "/Safety_Checklist",
                        "/Design_Inspiration",
                        "/Equipment_Rental_Guide"
                    ];

                    toolsPages.forEach(function (page) {
                        if (currentUrl.indexOf(page) !== -1) {
                            $('.navbar-nav .nav-link[href="/Tools_And_Utilities"]').addClass('active');
                        }
                    });
                }

                function redirectIfAspNet404() {
                    // Redirect target
                    var defaultRedirectUrl = '/';

                    // Detect .NET 404 error by specific title and common body error phrases
                    var title = document.title.trim().toLowerCase();
                    var bodyText = $('body').text().trim().toLowerCase();
                    var h1Text = $('h1').first().text().trim().toLowerCase();
                    var h2Text = $('h2').first().text().trim().toLowerCase();

                    alert(title);

                    var aspNet404Indicators = [
                        'the resource cannot be found.',        // Exact title/body value
                        'server error in \'/\' application',   // H1 text for .NET errors
                        'http 404',                            // Error description in .NET error pages
                        'requested url'                        // Shows up in .NET 404s
                    ];

                    var errorDetected = false;

                    // Title check (strict)
                    if (title === 'the resource cannot be found.') {
                        errorDetected = true;
                    }

                    // Body or header check (semi-strict: must find at least two major clues)
                    var majorMatched = 0;
                    aspNet404Indicators.forEach(function (indicator) {
                        if (bodyText.includes(indicator) || h1Text.includes(indicator) || h2Text.includes(indicator)) {
                            majorMatched++;
                        }
                    });

                    if (majorMatched >= 2) {
                        errorDetected = true;
                    }

                    if (errorDetected) {
                        window.location.href = defaultRedirectUrl;
                    }
                }

                function fun_cta_replace_title_dec() {
                    // Get the current page name from URL
                    var page = window.location.pathname.split("/").pop().toLowerCase();

                    // Define page-wise CTA headings & subheadings
                    var ctaContent = {
                        "": {
                            heading: "Ready to Start Your Project?",
                            subheading: "Choose your preferred contact method"
                        },
                        "services": {
                            heading: "Need Our Services?",
                            subheading: "Let’s discuss your requirements today"
                        },
                        "portfolio": {
                            heading: "Like Our Work?",
                            subheading: "Your project could be the next success story"
                        },
                        "about": {
                            heading: "Get to Know Us Better",
                            subheading: "We’re here to build lasting partnerships"
                        },
                        "contact": {
                            heading: "Have Questions?",
                            subheading: "We’d love to hear from you"
                        },
                        "tools_and_utilities": {
                            heading: "Try Our Tools",
                            subheading: "Boost your productivity with our solutions"
                        },
                        "login": {
                            heading: "Welcome Back!",
                            subheading: "Sign in to continue your journey with us"
                        }
                    };

                    // If current page matches, update CTA
                    if (ctaContent[page]) {
                        $(".cta-section h2").text(ctaContent[page].heading);
                        $(".cta-section p").text(ctaContent[page].subheading);
                    }

                }

                //#region Theme toggle, Header scroll, Initialize carousels, Copyright year
                function initializeSiteFeatures(options = {}) {
                    const defaults = {
                        themeToggleSelector: '#themeToggle',
                        navbarSelector: '.navbar',
                        scrollThreshold: 100,
                        heroCarouselSelector: '#heroCarousel',
                        heroCarouselInterval: 5000,
                        testimonialCarouselSelector: '#testimonialCarousel',
                        testimonialCarouselInterval: 4000,
                        smoothScrollOffset: 80,
                        smoothScrollDuration: 600,
                        mobileMenuSelector: '#navbarNav',
                        copyrightYearSelector: '#copyright-year',
                        copyrightText: null, // Custom text like '© {year} Company Name'
                        useCurrentYear: true
                    };

                    const config = { ...defaults, ...options };

                    // Initialize theme toggle
                    function initializeThemeToggle() {
                        const themeToggle = $(config.themeToggleSelector);
                        const themeIcon = themeToggle.find('i');

                        if (themeToggle.length === 0) return;

                        // Check for saved theme preference or respect OS preference
                        const savedTheme = localStorage.getItem('theme');
                        const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

                        if (savedTheme === 'dark' || (!savedTheme && systemPrefersDark)) {
                            document.documentElement.setAttribute('data-theme', 'dark');
                            themeIcon.removeClass('fa-moon').addClass('fa-sun');
                        } else {
                            document.documentElement.setAttribute('data-theme', 'light');
                            themeIcon.removeClass('fa-sun').addClass('fa-moon');
                        }

                        // Toggle theme on button click
                        themeToggle.click(function () {
                            const currentTheme = document.documentElement.getAttribute('data-theme');
                            if (currentTheme === 'light') {
                                document.documentElement.setAttribute('data-theme', 'dark');
                                themeIcon.removeClass('fa-moon').addClass('fa-sun');
                                localStorage.setItem('theme', 'dark');
                            } else {
                                document.documentElement.setAttribute('data-theme', 'light');
                                themeIcon.removeClass('fa-sun').addClass('fa-moon');
                                localStorage.setItem('theme', 'light');
                            }
                        });
                    }

                    // Initialize header scroll effect
                    function initializeHeaderScroll() {
                        $(window).scroll(function () {
                            if ($(this).scrollTop() > config.scrollThreshold) {
                                $(config.navbarSelector).addClass('scrolled');
                            } else {
                                $(config.navbarSelector).removeClass('scrolled');
                            }
                        });
                    }

                    // Initialize smooth scrolling
                    function initializeSmoothScrolling() {
                        $('a[href^="#"]').click(function (e) {
                            e.preventDefault();

                            const targetId = $(this).attr('href');
                            if (targetId === '#') return;

                            const targetElement = $(targetId);
                            if (targetElement.length) {
                                $('html, body').animate({
                                    scrollTop: targetElement.offset().top - config.smoothScrollOffset
                                }, config.smoothScrollDuration);

                                // Close mobile menu if open
                                $(config.mobileMenuSelector).removeClass('show');
                            }
                        });
                    }

                    // Initialize carousels
                    function initializeCarousels() {
                        if ($(config.heroCarouselSelector).length) {
                            $(config.heroCarouselSelector).carousel({
                                interval: config.heroCarouselInterval,
                                pause: false
                            });
                        }

                        if ($(config.testimonialCarouselSelector).length) {
                            $(config.testimonialCarouselSelector).carousel({
                                interval: config.testimonialCarouselInterval
                            });
                        }
                    }

                    // Initialize copyright year
                    function initializeCopyrightYear() {
                        const copyrightElement = $(config.copyrightYearSelector);

                        if (copyrightElement.length === 0) return;

                        const currentYear = new Date().getFullYear();

                        if (config.useCurrentYear) {
                            if (config.copyrightText) {
                                // Replace {year} placeholder or append year to custom text
                                const finalText = config.copyrightText.includes('{year}')
                                    ? config.copyrightText.replace('{year}', currentYear)
                                    : `${config.copyrightText} ${currentYear}`;
                                copyrightElement.text(finalText);
                            } else {
                                copyrightElement.text(currentYear);
                            }
                        }
                        // If useCurrentYear is false but custom text is provided, use the custom text as-is
                        else if (config.copyrightText) {
                            copyrightElement.text('');
                            copyrightElement.text(config.copyrightText);
                        }
                    }

                    // Initialize all features
                    initializeThemeToggle();
                    initializeHeaderScroll();
                    initializeSmoothScrolling();
                    initializeCarousels();
                    initializeCopyrightYear();

                    // Return public methods if needed
                    return {
                        reinitializeTheme: initializeThemeToggle,
                        reinitializeCarousels: initializeCarousels,
                        updateCopyrightYear: initializeCopyrightYear,
                        getConfig: () => ({ ...config })
                    };

                    // Usage examples:
                    // Basic usage with default selectors
                    // initializeSiteFeatures();

                    // Customized usage with copyright options
                    // initializeSiteFeatures({
                    //     themeToggleSelector: '#customThemeToggle',
                    //     navbarSelector: '.custom-navbar',
                    //     scrollThreshold: 150,
                    //     heroCarouselInterval: 7000,
                    //     smoothScrollOffset: 100,
                    //     copyrightYearSelector: '#footer-year',
                    //     copyrightText: '© {year} My Company Name. All rights reserved.'
                    // });

                    // Alternative copyright usage:
                    // initializeSiteFeatures({
                    //     copyrightYearSelector: '.copyright',
                    //     copyrightText: 'Copyright' // Will become "Copyright 2024"
                    // });

                    // initializeSiteFeatures({
                    //     copyrightYearSelector: '#footer-copyright',
                    //     useCurrentYear: false,
                    //     copyrightText: '© 2020-2024 Company Name' // Static text
                    // });
                }

               

                //#endregion Theme toggle, Header scroll, Initialize carousels, Copyright year
                $(document).ready(function () {

                    initNavbarToggle('#customNavToggler', '#topNavbarNav');
                    fun_cta_replace_title_dec();
                
                    preventDefaultActions(false, true);

                    activeCurrentPageNav();

                   
                    //$('#copyright-year').text(new Date().getFullYear());

                     initializeSiteFeatures({
                         copyrightYearSelector: '#copyright-year',
                         useCurrentYear: true,
                         copyrightText: '' // Static text
                     });


                });
            </script>
        </div>
<!-- Profile Modal -->
