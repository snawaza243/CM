<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="MediCare.SiteMaster" %>

<!DOCTYPE html>

<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - My ASP.NET Application</title>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>

    <webopt:BundleReference runat="server" Path="~/Content/css" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">


    <link href="~/Content/Site.css" rel="stylesheet" />
    <link href="~/Content/utilities.css" rel="stylesheet" />
    <link href="~/Content/theme.css" rel="stylesheet" />
    <link href="~/Content/layout.css" rel="stylesheet" />

    <%-- Component CSS --%>
    <style>
      /* Medical Status Badges */
.badge-medical {
  padding: 0.25rem 0.75rem;
  border-radius: 50px;
  font-size: 0.75rem;
  font-weight: 600;
}

.badge-prescription {
  background: var(--medical-purple);
  color: white;
}

.badge-otc {
  background: var(--medical-green);
  color: white;
}

.badge-expired {
  background: var(--medical-red);
  color: white;
}

.badge-expiring {
  background: var(--medical-amber);
  color: white;
}

/* Medical Cards */
.card-medical {
  background: var(--bg-primary);
  border: 1px solid var(--border-color);
  border-radius: var(--border-radius);
  box-shadow: var(--shadow-sm);
  transition: all 0.2s ease;
}

.card-medical:hover {
  box-shadow: var(--shadow-md);
}

.card-medical-header {
  padding: 1rem 1.5rem;
  border-bottom: 1px solid var(--border-color);
  background: var(--bg-secondary);
}

.card-medical-body {
  padding: 1.5rem;
}

/* Alert Styles */
.alert-medical {
  border: 1px solid;
  border-radius: var(--border-radius);
  padding: 1rem;
  margin-bottom: 1rem;
}

.alert-critical {
  background: #fef2f2;
  border-color: var(--medical-red);
  color: #dc2626;
}

[data-theme="dark"] .alert-critical {
  background: rgba(239, 68, 68, 0.1);
  color: #fca5a5;
}

.alert-warning {
  background: #fffbeb;
  border-color: var(--medical-amber);
  color: #d97706;
}

[data-theme="dark"] .alert-warning {
  background: rgba(245, 158, 11, 0.1);
  color: #fcd34d;
}

/* Data Grid Tables */
.table-medical {
  background: var(--bg-primary);
  border-radius: var(--border-radius);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.table-medical th {
  background: var(--bg-secondary);
  border-bottom: 1px solid var(--border-color);
  font-weight: 600;
  color: var(--text-primary);
  padding: 1rem;
}

.table-medical td {
  padding: 1rem;
  border-bottom: 1px solid var(--border-color);
  vertical-align: middle;
}

/* Action Buttons */
.btn-medical {
  border-radius: var(--border-radius);
  font-weight: 500;
  transition: all 0.2s ease;
}

.btn-medical-primary {
  background: var(--medical-blue);
  border-color: var(--medical-blue);
  color: white;
}

.btn-medical-primary:hover {
  background: #0284c7;
  border-color: #0284c7;
}
    </style>

    <%-- Layout CSS --%>
    <style>
        /* Main Layout */
        .app-container {
            display: flex;
            min-height: 100vh;
        }

        /* Sidebar */
        .sidebar {
            width: var(--sidebar-width);
            background: var(--sidebar-bg);
            color: var(--sidebar-text);
            position: fixed;
            height: 100vh;
            overflow-y: auto;
            transition: all 0.3s ease;
            z-index: 1000;
        }

        .sidebar-header {
            padding: 1.5rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            height: var(--header-height);
        }

        .sidebar-menu {
            padding: 1rem 0;
        }

        .menu-item {
            padding: 0.75rem 1.5rem;
            display: flex;
            align-items: center;
            color: var(--sidebar-text);
            text-decoration: none;
            transition: all 0.2s ease;
            border-left: 3px solid transparent;
        }

            .menu-item:hover, .menu-item.active {
                background: rgba(255, 255, 255, 0.1);
                border-left-color: var(--medical-blue);
                color: white;
            }

            .menu-item i {
                margin-right: 0.75rem;
                width: 20px;
                text-align: center;
            }

        /* Main Content */
        .main-content {
            flex: 1;
            /*margin-left: var(--sidebar-width);*/
            min-height: 100vh;
        }

        /* Top Header */
        .top-header {
            height: var(--header-height);
            background: var(--bg-primary);
            border-bottom: 1px solid var(--border-color);
            position: sticky;
            top: 0;
            z-index: 999;
        }

        /* Content Area */
        .content-wrapper {
            padding: 1.5rem;
        }


        /* ===== Responsive Sidebar ===== */
@media (max-width: 992px) {
    .sidebar {
        position: fixed;
        left: -260px;
    }

    .sidebar.active {
        left: 0;
    }

    .main-content {
        margin-left: 0;
    }

    .toggle-btn {
        position: fixed;
        top: 1rem;
        left: 1rem;
        background-color: var(--primary-color);
        color: #fff;
        border: none;
        padding: 0.5rem 0.8rem;
        border-radius: 8px;
        cursor: pointer;
        z-index: 1100;
        box-shadow: var(--shadow-md);
    }
}
    </style>

    <%-- Theme CSS --%>
    <style>
        :root {
            /* Primary Colors */
            --primary-color: #2563eb;
            --primary-dark: #1d4ed8;
            --primary-light: #3b82f6;
            /* Medical Theme Colors */
            --medical-blue: #0ea5e9;
            --medical-green: #10b981;
            --medical-red: #ef4444;
            --medical-amber: #f59e0b;
            --medical-purple: #8b5cf6;
            /* Neutral Colors - Light Mode */
            --bg-primary: #ffffff;
            --bg-secondary: #f8fafc;
            --bg-tertiary: #f1f5f9;
            --text-primary: #1e293b;
            --text-secondary: #64748b;
            --text-muted: #94a3b8;
            --border-color: #e2e8f0;
            --sidebar-bg: #1e293b;
            --sidebar-text: #f1f5f9;
            /* Shadows */
            --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
            --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1);
            --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1);
            /* Typography */
            --font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            --border-radius: 0.5rem;
            --sidebar-width: 260px;
            --header-height: 64px;
        }

        /* Dark Mode Variables */
        [data-theme="dark"] {
            --bg-primary: #0f172a;
            --bg-secondary: #1e293b;
            --bg-tertiary: #334155;
            --text-primary: #f1f5f9;
            --text-secondary: #cbd5e1;
            --text-muted: #64748b;
            --border-color: #334155;
            --sidebar-bg: #020617;
            --sidebar-text: #f1f5f9;
        }

        /* Base Styles */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: var(--font-family);
            background-color: var(--bg-secondary);
            color: var(--text-primary);
            transition: all 0.3s ease;
        }

        /* Theme Toggle Switch */
        .theme-toggle {
            width: 50px;
            height: 26px;
            background: var(--bg-tertiary);
            border-radius: 50px;
            position: relative;
            cursor: pointer;
            border: 2px solid var(--border-color);
        }

            .theme-toggle::before {
                content: '';
                position: absolute;
                width: 18px;
                height: 18px;
                border-radius: 50%;
                background: var(--primary-color);
                top: 2px;
                left: 2px;
                transition: transform 0.3s ease;
            }

        [data-theme="dark"] .theme-toggle::before {
            transform: translateX(24px);
        }
    </style>

    <%-- Utilities CSS --%>
    <style>
        /* Custom Utilities */
        .bg-medical-light {
            background: var(--bg-secondary);
        }

        .border-medical {
            border: 1px solid var(--border-color);
        }

        .text-medical-primary {
            color: var(--text-primary);
        }

        .text-medical-secondary {
            color: var(--text-secondary);
        }

        .shadow-medical {
            box-shadow: var(--shadow-md);
        }

        /* Status Indicators */
        .status-indicator {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            display: inline-block;
            margin-right: 0.5rem;
        }

        .status-active {
            background: var(--medical-green);
        }

        .status-pending {
            background: var(--medical-amber);
        }

        .status-inactive {
            background: var(--medical-red);
        }

        /* Loading Spinner */
        .spinner-medical {
            width: 2rem;
            height: 2rem;
            border: 2px solid var(--border-color);
            border-top: 2px solid var(--medical-blue);
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }
    </style>

    <%-- Category CSS --%>
    <style>
        /* Categories Page */
        .category-card {
            transition: transform 0.2s ease;
        }

            .category-card:hover {
                transform: translateY(-2px);
            }

        .category-icon {
            color: var(--primary-color);
        }

        /* Customers Page */
        .avatar-circle {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 0.875rem;
        }

        .avatar-circle-lg {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 1.25rem;
        }

        /* Suppliers Page */
        .supplier-card {
            transition: transform 0.2s ease;
        }

            .supplier-card:hover {
                transform: translateY(-2px);
            }

        .logo-placeholder {
            width: 50px;
            height: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
        }

        /* Reports Page */
        .stat-value {
            font-size: 1.5rem;
            font-weight: 600;
        }

        .stat-label {
            color: var(--text-muted);
        }

        /* Settings Page */
        .settings-nav .nav-link {
            border: none;
            border-radius: var(--border-radius);
            margin-bottom: 0.5rem;
            color: var(--text-primary);
            padding: 0.75rem 1rem;
        }

            .settings-nav .nav-link.active {
                background-color: var(--primary-color);
                color: white;
            }

            .settings-nav .nav-link:hover:not(.active) {
                background-color: var(--bg-tertiary);
            }
    </style>

    <%-- Uknown:Customer Model --%>
    <style>
        /* Customer Modal Specific Styles */
.modal-lg {
    max-width: 800px;
}

/* Form Section Styles */
.form-section {
    margin-bottom: 1.5rem;
}

.section-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--primary-color);
}

/* Input Group Styles */
.input-group-text {
    background-color: var(--bg-tertiary);
    border-color: var(--border-color);
    color: var(--text-muted);
    font-size: 0.875rem;
}

/* Switch Styles */
.form-check-input:checked {
    background-color: var(--primary-color);
    border-color: var(--primary-color);
}

.form-check-label {
    font-size: 0.875rem;
    color: var(--text-primary);
}

/* Template Button Styles */
.template-btn {
    font-size: 0.75rem;
    padding: 0.375rem 0.5rem;
}

/* Responsive adjustments for customer modal */
@media (max-width: 768px) {
    .modal-lg {
        margin: 0.5rem;
    }
    
    .modal-body {
        padding: 1rem;
    }
    
    .section-title {
        font-size: 0.85rem;
    }
}

/* Validation Styles */
.is-invalid {
    border-color: var(--medical-red) !important;
}

.invalid-feedback {
    display: block;
    font-size: 0.75rem;
    color: var(--medical-red);
    margin-top: 0.25rem;
}
    </style>

    <%-- Uknown: Order Details --%>
    <style>
        /* Order Status Badge */
.order-status-badge .badge {
    font-size: 0.9rem;
    padding: 0.5rem 1rem;
}

/* Timeline */
.timeline {
    position: relative;
    padding-left: 2rem;
}

.timeline::before {
    content: '';
    position: absolute;
    left: 15px;
    top: 0;
    bottom: 0;
    width: 2px;
    background-color: var(--border-color);
}

.timeline-item {
    position: relative;
    margin-bottom: 2rem;
}

.timeline-marker {
    position: absolute;
    left: -2rem;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 0.8rem;
}

.timeline-content {
    padding-bottom: 1rem;
}

/* Customer Avatar */
.avatar-circle {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 1rem;
}

/* Quantity Controls */
.quantity-controls .input-group {
    width: 120px;
}

.quantity-controls .btn {
    padding: 0.25rem 0.5rem;
}

.quantity-controls .form-control {
    padding: 0.25rem;
    text-align: center;
}

/* Prescription Thumbnails */
.prescription-thumbnail {
    text-align: center;
}

.prescription-thumbnail img {
    transition: transform 0.2s ease;
}

.prescription-thumbnail img:hover {
    transform: scale(1.05);
}

/* Customer Details */
.detail-item {
    display: flex;
    align-items: center;
}

.customer-stats .stat-value {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
}

.customer-stats .stat-label {
    color: var(--text-muted);
    font-size: 0.75rem;
}

/* Order Summary */
.summary-total {
    border-top: 2px solid var(--border-color);
    padding-top: 0.75rem;
    margin-top: 0.75rem;
}

/* Quick Actions */
.quick-actions .btn {
    font-size: 0.875rem;
}

/* Medicine Icons */
.medicine-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
}

/* Responsive Design */
@media (max-width: 768px) {
    .timeline {
        padding-left: 1.5rem;
    }
    
    .timeline-marker {
        left: -1.5rem;
        width: 25px;
        height: 25px;
        font-size: 0.7rem;
    }
    
    .order-status-badge .badge {
        font-size: 0.8rem;
        padding: 0.375rem 0.75rem;
    }
}
    </style>

</head>
<body>
    <form runat="server">
        <asp:ScriptManager runat="server">
            <Scripts>
                <%--To learn more about bundling scripts in ScriptManager see https://go.microsoft.com/fwlink/?LinkID=301884 --%>
                <%--Framework Scripts--%>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
                <%--Site Scripts--%>
            </Scripts>
        </asp:ScriptManager>

        <div class="app-container">
            <!-- Sidebar -->
            <nav class="sidebar">
                <div class="sidebar-header">
                    <h4 class="mb-0">
                        <i class="fas fa-clinic-medical text-primary"></i>
                        <span class="ms-2">MediCare</span>
                    </h4>
                </div>

                <div class="sidebar-menu">
                    <a href="/Views/Dashboard.aspx" class="menu-item active">
                        <i class="fas fa-chart-line"></i>
                        <span>Dashboard</span>
                    </a>

                    <div class="menu-section mt-3">
                        <small class="px-3 text-uppercase text-muted">Inventory</small>
                    </div>

                    <a href="/Views/Medicines.aspx" class="menu-item">
                        <i class="fas fa-pills"></i>
                        <span>Medicines</span>
                    </a>
                    <a href="/Views/Inventory.aspx" class="menu-item">
                        <i class="fas fa-boxes"></i>
                        <span>Inventory</span>
                    </a>
                    <a href="categories.aspx" class="menu-item">
                        <i class="fas fa-tags"></i>
                        <span>Categories</span>
                    </a>

                    <div class="menu-section mt-3">
                        <small class="px-3 text-uppercase text-muted">Orders</small>
                    </div>
                    <a href="/Views/Prescriptions.aspx" class="menu-item">
                        <i class="fas fa-file-prescription"></i>
                        <span>Prescription Verification</span>
                        <span class="badge bg-danger ms-2" id="pendingPrescriptionsCount">5</span>
                    </a>
                    <a href="/Views/Orders.aspx" class="menu-item">
                        <i class="fas fa-shopping-cart"></i>
                        <span>All Orders</span>
                    </a>

                    <div class="menu-section mt-3">
                        <small class="px-3 text-uppercase text-muted">Management</small>
                    </div>
                    <a href="/Views/Customers.aspx" class="menu-item">
                        <i class="fas fa-users"></i>
                        <span>Customers</span>
                    </a>
                    <a href="/Views/Suppliers.aspx" class="menu-item">
                        <i class="fas fa-truck"></i>
                        <span>Suppliers</span>
                    </a>
                    <a href="/Views/Reports.aspx" class="menu-item">
                        <i class="fas fa-chart-bar"></i>
                        <span>Reports</span>
                    </a>

                    <div class="menu-section mt-3">
