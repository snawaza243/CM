                                            </a>
                                            <a class="dropdown-item" href="#">
                                                <small>15 medicines expiring soon</small>
                                            </a>
                                            <a class="dropdown-item" href="#">
                                                <small>Low stock alert: Medicine XYZ</small>
                                            </a>
                                        </div>
                                    </div>

                                    <!-- User Menu -->
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle d-flex align-items-center"
                                            data-bs-toggle="dropdown">
                                            <i class="fas fa-user-circle me-2"></i>
                                            <span>Dr. Sarah Johnson</span>
                                        </button>
                                        <div class="dropdown-menu dropdown-menu-end">
                                            <a class="dropdown-item" href="#">
                                                <i class="fas fa-user me-2"></i>Profile
                                            </a>
                                            <a class="dropdown-item" href="#">
                                                <i class="fas fa-cog me-2"></i>Settings
                                            </a>
                                            <div class="dropdown-divider"></div>
                                            <a class="dropdown-item" href="#">
                                                <i class="fas fa-sign-out-alt me-2"></i>Logout
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </header>
                <!-- Content Area -->
                <div class="content-wrapper" id="mainContent">
                    <!-- Page content will be loaded here -->
                    <div id="pageContent">
                        <!-- Dashboard content will be loaded here by default -->
                        <asp:ContentPlaceHolder ID="MainContent" runat="server">
                        </asp:ContentPlaceHolder>
                        <hr />
                         <footer>
                            <p>&copy; <%: DateTime.Now.Year %> - My ASP.NET Application</p>
                        </footer>
                    </div>
                </div>
            </main>
        </div>
    </form>

    <%--<script src="~/Scripts/theme.js"></script>--%>
    <script>
        // Theme Management
        class ThemeManager {
            constructor() {
                this.currentTheme = localStorage.getItem('theme') || 'light';
                this.init();
            }

            init() {
                this.applyTheme(this.currentTheme);
                this.bindEvents();
            }

            applyTheme(theme) {
                document.documentElement.setAttribute('data-theme', theme);
                localStorage.setItem('theme', theme);
                this.currentTheme = theme;
            }

            toggleTheme() {
                const newTheme = this.currentTheme === 'light' ? 'dark' : 'light';
                this.applyTheme(newTheme);
            }

            bindEvents() {
                // Theme toggle
                const themeToggle = document.getElementById('themeToggle');
                if (themeToggle) {
                    themeToggle.addEventListener('click', () => this.toggleTheme());
                }

                // Sidebar toggle for mobile
                const sidebarToggle = document.getElementById('sidebarToggle');
                if (sidebarToggle) {
                    sidebarToggle.addEventListener('click', function (e) {
                        e.preventDefault(); // prevent default button or link behavior
                        this.toggleSidebar(); // call the method
                    }.bind(this)); // ensure "this" refers to the correct context

                }
            }

            toggleSidebar() {
                const sidebar = document.querySelector('.sidebar');
                const mainContent = document.querySelector('.main-content');

                sidebar.classList.toggle('collapsed');
                mainContent.classList.toggle('sidebar-collapsed');
            }
        }

        // Initialize theme manager when DOM is loaded
        document.addEventListener('DOMContentLoaded', () => {
            window.themeManager = new ThemeManager();
        });
    </script>


    <script>
        // Main Application JavaScript
        class MediCareAdmin {
            constructor() {
                this.currentPage = 'dashboard';
                this.init();
            }

            init() {
                this.loadPage(this.currentPage);
                this.bindNavigation();
                this.updatePendingPrescriptionsCount();
            }

            loadPage(page) {
                // In a real app, this would fetch HTML content
                // For now, we'll simulate page loading
                this.currentPage = page;
                document.getElementById('pageTitle').textContent = this.getPageTitle(page);

                // Update active menu item
                this.updateActiveMenuItem(page);

                // Load page content
                this.loadPageContent(page);
            }

            getPageTitle(page) {
                const titles = {
                    'dashboard': 'Dashboard',
                    'medicines': 'Medicine Management',
                    'prescriptions': 'Prescription Verification',
                    'orders': 'Order Management',
                    'inventory': 'Inventory Management',
                    'customers': 'Customer Management',
                    'reports': 'Reports & Analytics'
                };
                return titles[page] || 'MediCare Admin';
            }

            updateActiveMenuItem(page) {
                // Remove active class from all menu items
                document.querySelectorAll('.menu-item').forEach(item => {
                    item.classList.remove('active');
                });

                // Add active class to current page menu item
                const activeItem = document.querySelector(`[href="${page}.html"]`);
                if (activeItem) {
                    activeItem.classList.add('active');
                }
            }

            bindNavigation() {
                // Handle menu item clicks
                document.querySelectorAll('.menu-item').forEach(item => {
                    item.addEventListener('click', (e) => {
                        e.preventDefault();
                        const page = item.getAttribute('href').replace('.html', '');
                        this.loadPage(page);
                    });
                });
            }

            updatePendingPrescriptionsCount() {
                // Simulate fetching pending prescriptions count
                const count = Math.floor(Math.random() * 10) + 1;
                const badge = document.getElementById('pendingPrescriptionsCount');
                if (badge) {
                    badge.textContent = count;
                }
            }

            loadPageContent(page) {
                const contentArea = document.getElementById('pageContent');

                // Simulate different page content
                const pageContents = {
                    'dashboard': this.getDashboardContent(),
                    'medicines': this.getMedicinesContent(),
                    'prescriptions': this.getPrescriptionsContent()
                };

                contentArea.innerHTML = pageContents[page] || '<div class="alert alert-info">Page content loading...</div>';
            }

            getDashboardContent() {
                return `
            <div class="row">
                <div class="col-12">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4>Pharmacy Dashboard</h4>
                        <div class="d-flex gap-2">
                            <button class="btn btn-medical btn-medical-primary">
                                <i class="fas fa-plus me-2"></i>Add Medicine
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Critical Alerts -->
            <div class="row mb-4">
                <div class="col-12">
                    <div class="alert-medical alert-critical">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-exclamation-triangle me-3"></i>
                            <div>
                                <strong>Critical Alert:</strong> 15 medicines are expiring in the next 30 days. 
                                <a href="#" class="alert-link">Review Now</a>
                            </div>
                        </div>
                    </div>
                    <div class="alert-medical alert-warning">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-clock me-3"></i>
                            <div>
                                <strong>Action Required:</strong> 8 prescriptions are pending verification.
                                <a href="prescriptions.html" class="alert-link">Verify Now</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Stats Cards -->
            <div class="row mb-4">
                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card-medical">
                        <div class="card-medical-body">
                            <div class="d-flex align-items-center">
                                <div class="flex-grow-1">
                                    <h6 class="text-medical-secondary mb-2">Total Medicines</h6>
                                    <h3 class="mb-0">1,247</h3>
                                </div>
                                <div class="flex-shrink-0">
                                    <i class="fas fa-pills fa-2x text-primary"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card-medical">
                        <div class="card-medical-body">
                            <div class="d-flex align-items-center">
                                <div class="flex-grow-1">
                                    <h6 class="text-medical-secondary mb-2">Pending Prescriptions</h6>
                                    <h3 class="mb-0">8</h3>
                                </div>
                                <div class="flex-shrink-0">
                                    <i class="fas fa-file-prescription fa-2x text-warning"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card-medical">
                        <div class="card-medical-body">
                            <div class="d-flex align-items-center">
                                <div class="flex-grow-1">
                                    <h6 class="text-medical-secondary mb-2">Expiring Soon</h6>
                                    <h3 class="mb-0">15</h3>
                                </div>
                                <div class="flex-shrink-0">
                                    <i class="fas fa-exclamation-triangle fa-2x text-danger"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card-medical">
                        <div class="card-medical-body">
                            <div class="d-flex align-items-center">
                                <div class="flex-grow-1">
                                    <h6 class="text-medical-secondary mb-2">Today's Orders</h6>
                                    <h3 class="mb-0">24</h3>
                                </div>
                                <div class="flex-shrink-0">
                                    <i class="fas fa-shopping-cart fa-2x text-success"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        `;
            }

            getMedicinesContent() {
                return `
            <div class="row">
                <div class="col-12">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4>Medicine Management</h4>
                        <button class="btn btn-medical btn-medical-primary">
                            <i class="fas fa-plus me-2"></i>Add New Medicine
                        </button>
                    </div>
                    
                    <!-- Medicine List Table -->
                    <div class="card-medical">
                        <div class="card-medical-header">
                            <h6 class="mb-0">All Medicines</h6>
                        </div>
                        <div class="card-medical-body">
                            <div class="table-responsive">
                                <table class="table table-medical table-hover">
                                    <thead>
                                        <tr>
                                            <th>Medicine Name</th>
                                            <th>Salt Composition</th>
                                            <th>Category</th>
                                            <th>Type</th>
                                            <th>Stock</th>
                                            <th>Expiry Date</th>
                                            <th>Status</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>
                                                <strong>Paracetamol 500mg</strong>
                                                <div class="text-muted small">PAN-001</div>
                                            </td>
                                            <td>Paracetamol</td>
                                            <td>Analgesic</td>
                                            <td><span class="badge-medical badge-otc">OTC</span></td>
                                            <td>
                                                <span class="text-success">145</span>
                                            </td>
                                            <td>Dec 2024</td>
                                            <td><span class="status-indicator status-active"></span> Active</td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <button class="btn btn-outline-primary">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button class="btn btn-outline-danger">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                <strong>Amoxicillin 250mg</strong>
                                                <div class="text-muted small">AMX-002</div>
                                            </td>
                                            <td>Amoxicillin Trihydrate</td>
                                            <td>Antibiotic</td>
                                            <td><span class="badge-medical badge-prescription">Rx</span></td>
                                            <td>
                                                <span class="text-warning">12</span>
                                            </td>
                                            <td>Mar 2025</td>
                                            <td><span class="status-indicator status-active"></span> Active</td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <button class="btn btn-outline-primary">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button class="btn btn-outline-danger">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        `;
            }

            getPrescriptionsContent() {
                return `
            <div class="row">
                <div class="col-12">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4>Prescription Verification</h4>
                        <div class="text-muted">
                            <span class="badge bg-warning">8 Pending</span>
                        </div>
                    </div>
                    
                    <!-- Prescription Queue -->
                    <div class="card-medical">
                        <div class="card-medical-header">
                            <h6 class="mb-0">Pending Verifications</h6>
                        </div>
                        <div class="card-medical-body">
                            <div class="row">
                                <!-- Prescription Card -->
                                <div class="col-md-6 col-lg-4 mb-4">
                                    <div class="card-medical h-100">
                                        <div class="card-medical-body">
                                            <div class="d-flex justify-content-between align-items-start mb-3">
                                                <div>
                                                    <h6 class="mb-1">Order #MED-001</h6>
                                                    <small class="text-muted">Dr. Sharma</small>
                                                </div>
                                                <span class="badge bg-warning">Pending</span>
                                            </div>
                                            
                                            <div class="mb-3">
                                                <strong>Medicines:</strong>
                                                <ul class="small mt-1 mb-2">
                                                    <li>Amoxicillin 250mg</li>
                                                    <li>Paracetamol 500mg</li>
                                                </ul>
                                            </div>
                                            
                                            <div class="prescription-image mb-3">
                                                <img src="https://via.placeholder.com/250x150" 
                                                     alt="Prescription" 
                                                     class="img-fluid rounded border"
                                                     style="cursor: pointer"
                                                     data-bs-toggle="modal" 
                                                     data-bs-target="#prescriptionModal">
                                            </div>
                                            
                                            <div class="d-grid gap-2">
                                                <button class="btn btn-success btn-sm">
                                                    <i class="fas fa-check me-1"></i>Approve
                                                </button>
                                                <button class="btn btn-danger btn-sm">
                                                    <i class="fas fa-times me-1"></i>Reject
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- More prescription cards would go here -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        `;
            }
        }

        // Initialize the application
        document.addEventListener('DOMContentLoaded', () => {
            //window.medicareAdmin = new MediCareAdmin();
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/Scripts/bootstrap.js") %>
    </asp:PlaceHolder>
</body>
</html>
